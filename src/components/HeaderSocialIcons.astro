---
// Добавляет иконку pathofstrategy.com первой в группу иконок шапки
// Starlight (перед GitHub), поверх стандартного SocialIcons.
// Иконки соцсетей (GitHub, RSS) рендерим сами вместо встроенного <Default />,
// чтобы добавить target="_blank" — стандартный компонент Starlight его не ставит.
import { Image } from 'astro:assets';
import { Icon } from '@astrojs/starlight/components';
import config from 'virtual:starlight/user-config';
import logo from '../assets/pathofstrategy-logo.png';

const links = config.social || [];
---

<a href="https://pathofstrategy.com/" target="_blank" rel="noopener noreferrer" class="sl-flex" aria-label="Путь стратегии">
	<Image src={logo} alt="Путь стратегии" width={16} height={16} loading="eager" />
</a>
{
	links.length > 0 && (
		<>
			{links.map(({ label, href, icon }) => (
				<a href={href} target="_blank" rel="me noopener noreferrer" class="sl-flex">
					<span class="sr-only">{label}</span>
					<Icon name={icon} />
				</a>
			))}
		</>
	)
}

<style>
	@layer starlight.core {
		a {
			color: var(--sl-color-text-accent);
			padding: 0.5em;
			margin: -0.5em;
		}
		a:hover {
			color: var(--sl-color-white);
		}
		img {
			width: 1em;
			height: 1em;
			object-fit: contain;
		}
	}
</style>
