---
// Добавляет иконку pathofstrategy.com первой в группу иконок шапки
// Starlight (перед GitHub), поверх стандартного SocialIcons.
import { Image } from 'astro:assets';
import Default from '@astrojs/starlight/components/SocialIcons.astro';
import logo from '../assets/pathofstrategy-logo.png';
---

<a href="https://pathofstrategy.com/" target="_blank" rel="noopener noreferrer" class="sl-flex" aria-label="Путь стратегии">
	<Image src={logo} alt="Путь стратегии" width={16} height={16} loading="eager" />
</a>
<Default><slot /></Default>

<style>
	@layer starlight.core {
		a {
			color: var(--sl-color-text-accent);
			padding: 0.5em;
			margin: -0.5em;
		}
		a:hover {
			color: var(--sl-color-white);
		}
		img {
			width: 1em;
			height: 1em;
			object-fit: contain;
		}
	}
</style>
