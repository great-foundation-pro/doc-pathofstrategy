---
// Добавляет уникальную og:image для каждой страницы документации
// (astro-og-canvas), а также структурированные данные Schema.org:
// хлебные крошки (по дереву sidebar Starlight) и карточку книги/главы
// (для страниц из коллекции texts/). twitter:card Starlight уже
// проставляет сам в head.ts — свой дубль не добавляем.
import Default from '@astrojs/starlight/components/Head.astro';
import { Schema } from 'astro-seo-schema';
import { getEntry } from 'astro:content';

const { entry, sidebar, locale, entryMeta, id: routeId } = Astro.locals.starlightRoute;
const ogImageUrl = new URL(`/open-graph/${entry.id}.png`, Astro.site);
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();

// route.id всегда содержит префикс локали (в т.ч. на fallback-страницах —
// непереведённых, где показывается контент из ru). entry.id для fallback
// при этом остаётся БЕЗ префикса (это тот же объект, что и у ru-страницы),
// поэтому для локали используем именно route.id, а не entry.id.
const path = locale ? routeId.slice(locale.length + 1) : routeId;

function withTrailingSlash(url) {
  return url.endsWith('/') ? url : `${url}/`;
}

// Для собственных захардкоженных путей ('/', '/introduction/', '/blog/') —
// префикс локали нужно добавить самим, Starlight об этом не знает.
function toAbsoluteUrl(href) {
  const localizedHref = locale ? `/${locale}${href}` : href;
  return withTrailingSlash(new URL(localizedHref, Astro.site).toString());
}

// Для ссылок, уже пришедших из sidebar (Astro.locals.starlightRoute.sidebar) —
// Starlight сам подставляет туда префикс локали, повторно добавлять нельзя.
function sidebarHrefToAbsoluteUrl(href) {
  return withTrailingSlash(new URL(href, Astro.site).toString());
}

// --- Хлебные крошки ---

// Находит цепочку узлов sidebar (группы + текущая ссылка) до активной страницы.
function findActiveTrail(entries, trail = []) {
  for (const item of entries) {
    if (item.type === 'link' && item.isCurrent) return [...trail, item];
    if (item.type === 'group') {
      const found = findActiveTrail(item.entries, [...trail, item]);
      if (found) return found;
    }
  }
  return null;
}

// В группах текстов первым пунктом всегда идёт ссылка «Обзор» — она же
// представляет группу как кликабельную страницу в хлебных крошках. Если
// такой ссылки нет (напр. группа «О проекте»), берём первую ссылку группы.
function findOverviewHref(entries) {
  const overview = entries.find((item) => item.type === 'link' && item.label === 'Обзор');
  if (overview) return overview.href;
  const firstLink = entries.find((item) => item.type === 'link');
  return firstLink?.href;
}

const trail = findActiveTrail(sidebar) ?? [];

// У лендинга теперь есть локализованная версия (src/pages/en/index.astro).
const breadcrumbItems = [{ name: 'Главная', item: toAbsoluteUrl('/') }];

if (path.startsWith('texts/')) {
  breadcrumbItems.push({ name: 'Библиотека', item: toAbsoluteUrl('/introduction/') });
} else if (path.startsWith('blog/')) {
  // Посты блога не входят в дерево sidebar, поэтому родителя добавляем вручную.
  breadcrumbItems.push({ name: 'Заметки', item: toAbsoluteUrl('/blog/') });
}

for (const node of trail) {
  if (node.type === 'group') {
    const href = findOverviewHref(node.entries);
    breadcrumbItems.push({
      name: node.label,
      item: href ? sidebarHrefToAbsoluteUrl(href) : undefined,
    });
  }
}

breadcrumbItems.push({ name: entry.data.title, item: canonicalUrl });

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems.map((crumb, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: crumb.name,
    ...(crumb.item ? { item: crumb.item } : {}),
  })),
};

// --- Карточка книги/главы (только для раздела /texts/) ---

const PUBLISHER = { '@type': 'Organization', name: 'Путь стратегии', url: 'https://doc.pathofstrategy.com' };

let bookSchema;
const idParts = path.split('/');
if (idParts[0] === 'texts' && idParts.length >= 2) {
  const bookSlug = idParts[1];
  const bookUrl = toAbsoluteUrl(`/texts/${bookSlug}/`);
  // Для поиска в коллекции нужен полный id с префиксом локали
  // (напр. 'en/texts/sunzi'), иначе на EN-странице подтянется книга из ru.
  const bookContentId = locale ? `${locale}/texts/${bookSlug}` : `texts/${bookSlug}`;

  if (idParts.length === 2) {
    // Страница-обзор всего трактата.
    bookSchema = {
      '@context': 'https://schema.org',
      '@type': 'Book',
      name: entry.data.title,
      description: entry.data.description,
      url: canonicalUrl,
      inLanguage: entryMeta.lang,
      publisher: PUBLISHER,
    };
  } else {
    // Отдельная глава — часть книги.
    const bookEntry = await getEntry('docs', bookContentId);
    bookSchema = {
      '@context': 'https://schema.org',
      '@type': 'Chapter',
      name: entry.data.title,
      description: entry.data.description,
      url: canonicalUrl,
      inLanguage: entryMeta.lang,
      isPartOf: {
        '@type': 'Book',
        name: bookEntry?.data.title ?? bookSlug,
        url: bookUrl,
      },
      publisher: PUBLISHER,
    };
  }
}
---

<Default><slot /></Default>
<meta property="og:image" content={ogImageUrl} />
<meta name="twitter:image" content={ogImageUrl} />
<Schema item={breadcrumbSchema} />
{bookSchema && <Schema item={bookSchema} />}
