---
// src/pages/index.astro — landing page
import '../styles/global.css';
import { Icon } from 'astro-iconify';
---

<!DOCTYPE html>
<html lang="ru" style="scroll-behavior:smooth;">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Путь стратегии · 战略之道 · Колодезная система 井</title>
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icon-192.png" />
    <meta name="description" content="Полный свод древнекитайских классических трактатов об управлении, государстве и стратегии. 24 источника в структуре сезонов и центра (колодезная система 井)." />
    
    <!-- Open Graph / Facebook / Telegram -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://doc.pathofstrategy.com/" />
    <meta property="og:title" content="Путь стратегии · 战略之道 · Колодезная система 井" />
    <meta property="og:description" content="Полный свод древнекитайских классических трактатов об управлении, государстве и стратегии. 24 источника в структуре сезонов и центра." />
    <meta property="og:image" content="https://doc.pathofstrategy.com/images/hero-bg.webp" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content="https://doc.pathofstrategy.com/" />
    <meta property="twitter:title" content="Путь стратегии · 战略之道 · Колодезная система 井" />
    <meta property="twitter:description" content="Полный свод древнекитайских классических трактатов об управлении, государстве и стратегии. 24 источника в структуре сезонов и центра." />
    <meta property="twitter:image" content="https://doc.pathofstrategy.com/images/hero-bg.webp" />
    
    <!-- External Scripts & Styles -->
    <script src="/scripts/iconify-icon.min.js" is:inline></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500;1,600;1,700&family=DM+Sans:ital,wght@0,100..900;1,100..900&family=Noto+Serif+SC:wght@200..900&family=Source+Serif+4:ital,opsz,wght@0,8..60;1,8..60&display=swap" />

    <!-- Custom Animation Styles -->
    <style is:inline>
      @keyframes fadeUp { 
        0% { opacity: 0; transform: translateY(24px); }
        100% { opacity: 1; transform: translateY(0px); }
      }
      .animate-fade-up {
        animation: 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0s 1 normal forwards running fadeUp;
        opacity: 0;
      }
      .delay-150 { animation-delay: 150ms; }
      .delay-300 { animation-delay: 300ms; }
      .delay-450 { animation-delay: 450ms; }
      
      /* Smooth transition for category filtering scrollbar */
      .no-scrollbar::-webkit-scrollbar {
        display: none;
      }
      .no-scrollbar {
        -ms-overflow-style: none;
        scrollbar-width: none;
      }
    </style>
</head>

<body class="min-h-screen overflow-x-hidden bg-[#F4F0E6] text-[#0A1F15] antialiased" style="font-family:'Source Serif 4', Georgia, serif;">
    <main class="relative overflow-hidden">
      
      <!-- HEADER -->
      <header class="fixed left-0 right-0 top-0 z-50 border-b border-[#C49538]/20 bg-[#F4F0E6]/85 backdrop-blur-xl transition duration-300">
        <div class="mx-auto flex max-w-[88rem] h-20 items-center justify-between px-5 sm:px-8 lg:px-14 xl:px-20">
          <a href="#hero" class="flex items-center gap-3 group">
            <Icon name="mdi:yin-yang" class="text-3xl text-[#0A1F15] -scale-x-100 rotate-180 transition-transform duration-700 group-hover:rotate-0" />
            <span class="text-[2.5rem] font-normal tracking-tight text-[#0A1F15] leading-none" style="font-family:'Kashima','DS China','Cormorant Garamond',Georgia,serif;">
              Путь стратегии
            </span>
          </a>
          <nav class="hidden md:flex items-center gap-6 sm:gap-8 text-sm font-medium text-[#0A1F15]/75" style="font-family:'DM Sans',system-ui,sans-serif;">
            <a href="/about/" class="hover:text-[#2D8B5E] transition">О проекте</a>
            <a href="/introduction/" class="hover:text-[#2D8B5E] transition">Библиотека</a>
            <a href="/blog/" class="hover:text-[#2D8B5E] transition">Заметки</a>
            <a href="https://github.com/great-foundation-pro/doc-pathofstrategy" target="_blank" rel="noopener noreferrer" class="flex items-center gap-1 hover:text-[#2D8B5E] transition" aria-label="GitHub">
              <Icon name="mdi:github" class="text-lg" />
              <Icon name="mdi:open-in-new" class="text-xs" />
            </a>
            <a href="https://pathofstrategy.com/" target="_blank" rel="noopener noreferrer" class="flex items-center gap-1 hover:opacity-75 transition" aria-label="Путь стратегии">
              <img src="/images/pathofstrategy-logo.png" alt="Путь стратегии" class="h-5 w-5" />
              <Icon name="mdi:open-in-new" class="text-xs" />
            </a>
            <a href="https://doc.pathofstrategy.com/blog/rss.xml" class="flex items-center hover:text-[#2D8B5E] transition" aria-label="RSS">
              <Icon name="mdi:rss" class="text-lg" />
            </a>
            <a href="/en/" class="rounded-md border border-[#0A1F15]/15 px-2 py-1 text-xs font-semibold uppercase tracking-wide hover:border-[#2D8B5E] hover:text-[#2D8B5E] transition" aria-label="Switch to English" hreflang="en">
              EN
            </a>
            <a href="https://pathofstrategy.com/community/" target="_blank" rel="noopener noreferrer" class="flex h-10 items-center justify-center rounded-lg bg-[#0A1F15] px-4 text-xs font-semibold text-[#F4F0E6] hover:bg-[#123625] transition shadow-md">
              Войти в ворота
            </a>
          </nav>

          <button id="mobileMenuButton" type="button" class="flex h-10 w-10 items-center justify-center rounded-lg text-[#0A1F15] transition hover:bg-black/5 md:hidden" aria-label="Открыть меню" aria-expanded="false" aria-controls="mobileMenu">
            <Icon id="mobileMenuIconOpen" name="mdi:menu" class="text-2xl" />
            <Icon id="mobileMenuIconClose" name="mdi:close" class="hidden text-2xl" />
          </button>
        </div>

        <!-- Mobile dropdown menu -->
        <div id="mobileMenu" class="absolute left-0 right-0 top-full z-50 hidden flex-col gap-1 border-t border-[#C49538]/20 bg-[#F4F0E6] px-5 py-5 shadow-[0_24px_60px_rgba(10,31,21,0.14)] md:hidden" style="font-family:'DM Sans',system-ui,sans-serif;">
          <a href="/about/" class="rounded-lg px-3 py-3 text-base font-medium text-[#0A1F15]/80 transition hover:bg-[#2D8B5E]/10 hover:text-[#2D8B5E]">О проекте</a>
          <a href="/introduction/" class="rounded-lg px-3 py-3 text-base font-medium text-[#0A1F15]/80 transition hover:bg-[#2D8B5E]/10 hover:text-[#2D8B5E]">Библиотека</a>
          <a href="/blog/" class="rounded-lg px-3 py-3 text-base font-medium text-[#0A1F15]/80 transition hover:bg-[#2D8B5E]/10 hover:text-[#2D8B5E]">Заметки</a>
          <a href="https://github.com/great-foundation-pro/doc-pathofstrategy" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 rounded-lg px-3 py-3 text-base font-medium text-[#0A1F15]/80 transition hover:bg-[#2D8B5E]/10 hover:text-[#2D8B5E]">
            <Icon name="mdi:github" class="text-lg" /> GitHub
            <Icon name="mdi:open-in-new" class="text-xs" />
          </a>
          <a href="https://pathofstrategy.com/" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 rounded-lg px-3 py-3 text-base font-medium text-[#0A1F15]/80 transition hover:bg-[#2D8B5E]/10 hover:text-[#2D8B5E]">
            <img src="/images/pathofstrategy-logo.png" alt="" class="h-5 w-5" /> Путь стратегии
            <Icon name="mdi:open-in-new" class="text-xs" />
          </a>
          <a href="https://doc.pathofstrategy.com/blog/rss.xml" class="flex items-center gap-2 rounded-lg px-3 py-3 text-base font-medium text-[#0A1F15]/80 transition hover:bg-[#2D8B5E]/10 hover:text-[#2D8B5E]">
            <Icon name="mdi:rss" class="text-lg" /> RSS
          </a>
          <a href="/en/" class="flex items-center gap-2 rounded-lg px-3 py-3 text-base font-medium text-[#0A1F15]/80 transition hover:bg-[#2D8B5E]/10 hover:text-[#2D8B5E]" hreflang="en">
            English version
          </a>
          <a href="https://pathofstrategy.com/community/" target="_blank" rel="noopener noreferrer" class="mt-2 flex h-12 items-center justify-center rounded-lg bg-[#0A1F15] px-4 text-sm font-semibold text-[#F4F0E6] shadow-md transition hover:bg-[#123625]">
            Войти в ворота
          </a>
        </div>
      </header>
      <div id="mobileMenuBackdrop" class="fixed inset-x-0 bottom-0 top-20 z-40 hidden bg-[#0A1F15]/40 md:hidden"></div>

      <!-- HERO SECTION -->
      <section class="relative min-h-screen flex flex-col items-center justify-start overflow-hidden px-5 pb-20 pt-36 sm:pt-40 lg:px-10" id="hero">
        <div class="absolute inset-0 z-0">
          <img src="/images/hero-bg.webp" alt="Древний город Чжоу и библиотека" class="h-full w-full object-cover object-center">
        </div>

        <!-- Scrim layers: Dense for mobile, gradient for desktop + radial lighting behind text -->
        <div class="absolute inset-0 z-[1] bg-[#F4F0E6]/92 sm:hidden"></div>
        <div class="absolute inset-0 z-[1] hidden sm:block" style="background: linear-gradient(to bottom, rgba(244, 240, 230, 0.78) 0%, rgba(244, 240, 230, 0.55) 45%, rgba(244, 240, 230, 0.2) 75%, transparent 100%);"></div>
        <div class="absolute inset-0 z-[2] pointer-events-none" style="background: radial-gradient(ellipse 65% 50% at 50% 35%, rgba(255, 255, 255, 0.85) 0%, rgba(244, 240, 230, 0.4) 60%, transparent 100%);"></div>

        <div class="relative z-10 flex w-full max-w-4xl flex-col items-center text-center animate-fade-up">
          <!-- 1. Badge (Бейдж) -->
          <div class="inline-flex items-center gap-2.5 rounded-full border border-[#2D8B5E]/30 bg-[#F4F0E6]/85 px-4 py-1.5 shadow-sm backdrop-blur-md font-sans">
            <span class="h-[6px] w-[6px] rounded-full bg-[#E03030]"></span>
            <span class="text-[10px] font-semibold uppercase tracking-[0.2em] text-[#2D8B5E] sm:text-[11px]">
              ДОКУМЕНТАЦИОННЫЙ ПОРТАЛ
            </span>
          </div>

          <!-- 2. Brand signature (Брендовая подпись) -->
          <div class="mt-8 flex items-baseline justify-center gap-2 sm:gap-3 animate-fade-up delay-150">
            <span class="text-3xl font-medium tracking-wider text-[#C49538] font-notoserif sm:text-4xl">
              战略之道
            </span>
          </div>

          <!-- 3. H1 Dominant -->
          <h1 class="mt-4 text-5xl font-normal leading-[1.02] tracking-tight text-[#050C08] sm:text-7xl lg:text-[5.5rem] font-cormorant animate-fade-up delay-300">
            Библиотека свитков
          </h1>

          <!-- 4. Marker string (Маркер-строка) -->
          <p class="mt-2 text-sm font-medium italic tracking-wide text-[#C49538] font-sans sm:text-base animate-fade-up delay-300">
            Не аналогия — исток.
          </p>

          <!-- 5. Subtitle (Тезис) -->
          <p class="mt-6 max-w-[46rem] text-base leading-relaxed text-[#2A2A22]/90 sm:text-lg sm:leading-8 font-serif animate-fade-up delay-450">
            Единый код древних текстов — четыре сезона и центр — напрямую лежит
            в основе современных моделей управления, государства и бизнеса.
            <br class="hidden sm:block">
            Свод источников, от 3000 до н.э. до династии Чжоу, собран и описан
            здесь — библиотека растёт по мере находки и перевода новых текстов.
          </p>

          <!-- 6. Meta string (Мета-строка) -->
          <div class="mt-8 flex flex-wrap items-center justify-center gap-x-3 gap-y-2 text-xs text-[#0A1F15]/50 sm:mt-10 sm:text-sm font-sans animate-fade-up delay-450">
            <span id="metaSourceCount">23 источника</span>
            <span class="text-[#0A1F15]/25">·</span>
            <span>6 категорий</span>
            <span class="text-[#0A1F15]/25">·</span>
            <span class="flex items-center gap-1">
              <span class="text-base text-[#C49538] leading-none mb-0.5 font-notoserif">
                井
              </span>
              колодезная система
            </span>
            <span class="text-[#0A1F15]/25">·</span>
            <span>открыты для чтения</span>
          </div>

          <!-- 7. Buttons -->
          <div class="mt-10 flex w-full flex-col items-center justify-center gap-4 sm:w-auto sm:flex-row sm:gap-5 font-sans animate-fade-up delay-450">
            <a href="#system" class="group flex h-14 w-full items-center justify-center gap-3 rounded-xl border border-[#C49538] bg-[#F4F0E6]/70 backdrop-blur-sm px-9 text-sm font-medium text-[#0A1F15] transition hover:-translate-y-0.5 hover:bg-[#F4F0E6]/90 sm:w-auto">
              Смотреть структуру
              <span class="text-xl leading-none text-[#C49538] font-notoserif">
                井
              </span>
            </a>
            <a href="#library" class="group flex h-14 w-full items-center justify-center gap-3 rounded-xl bg-[#050C08] px-9 text-sm font-medium text-[#F4F0E6] shadow-[0_20px_50px_rgba(10,31,21,0.22)] transition hover:-translate-y-0.5 hover:bg-[#123625] sm:w-auto">
              Войти в библиотеку  ↓
            </a>
          </div>
        </div>
      </section>

      <!-- SYSTEM SECTION -->
      <section id="system" class="relative bg-[#0A1F15] px-5 py-24 text-[#F4F0E6] sm:px-8 lg:px-10">
        <div class="absolute inset-0 pointer-events-none bg-[radial-gradient(circle_at_18%_25%,rgba(196,149,56,0.14),transparent_28rem),radial-gradient(circle_at_84%_72%,rgba(45,139,94,0.22),transparent_30rem)]"></div>
        <div class="relative mx-auto grid max-w-[88rem] grid-cols-1 gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
          <div>
            <p class="text-xs font-medium uppercase tracking-[0.26em] text-[#C49538]" style="font-family:'DM Sans',system-ui,sans-serif;">
              Карта системы
            </p>
            <h2 class="mt-6 text-5xl font-normal leading-[1.02] tracking-tight sm:text-6xl lg:text-7xl" style="font-family:'Cormorant Garamond',Georgia,serif;">
              Четыре сезона + центр как навигационная решётка 井
            </h2>
            <p class="mt-7 max-w-2xl text-lg leading-8 text-[#F4F0E6]/72">
              Корпус организован не по внешним темам, а по месту текста в общей
              структуре: направление, сезон, центр, функция. Это позволяет
              читать источники как единую документацию управленческого кода.
            </p>
            <div class="mt-9 grid grid-cols-1 gap-4 sm:grid-cols-3" style="font-family:'DM Sans',system-ui,sans-serif;">
              <div class="rounded-2xl border border-white/10 bg-white/[0.06] p-5">
                <p class="text-3xl font-medium text-[#C49538]">4</p>
                <p class="mt-2 text-sm leading-6 text-[#F4F0E6]/62">
                  четыре сезона года
                </p>
              </div>
              <div class="rounded-2xl border border-white/10 bg-white/[0.06] p-5">
                <p class="text-3xl font-medium text-[#08C8A8]">1</p>
                <p class="mt-2 text-sm leading-6 text-[#F4F0E6]/62">
                  центр управления
                </p>
              </div>
              <div class="rounded-2xl border border-white/10 bg-white/[0.06] p-5">
                <p class="text-3xl font-medium text-[#E03030]">5</p>
                <p class="mt-2 text-sm leading-6 text-[#F4F0E6]/62">
                  пять — единая мера
                </p>
              </div>
            </div>
          </div>

          <div class="rounded-[2rem] border border-white/12 bg-white/[0.06] p-5 shadow-[0_36px_110px_rgba(0,0,0,0.28)] backdrop-blur-xl">
            <!-- Крестообразная (井) сетка: 4 сезона по углам (заголовки — к внешним краям),
                 "Сборка целого" — квадрат по центру стыка -->
            <div class="relative grid grid-cols-1 gap-4 md:grid-cols-2 md:grid-rows-2">
              <!-- Верхний левый: label -> заголовок -> текст, всё прижато к верхнему краю -->
              <article class="order-4 flex h-full flex-col rounded-2xl border border-[#08C8A8]/25 bg-[#08C8A8]/10 p-5 md:order-1">
                <p class="text-xs font-medium uppercase tracking-[0.18em] text-[#08C8A8]" style="font-family:'DM Sans',system-ui,sans-serif;">
                  Весна · Юго-Восток · 4
                </p>
                <h3 class="mt-4 text-3xl font-normal tracking-tight" style="font-family:'Cormorant Garamond',Georgia,serif;">
                  Запуск и рост
                </h3>
                <p class="mt-3 text-sm leading-6 text-[#F4F0E6]/68 md:max-w-[68%]">
                  Образование формы, прорастание функции, начало управляемого
                  цикла.
                </p>
              </article>
              <!-- Верхний правый: та же логика, текст сужен к внешнему краю -->
              <article class="order-1 flex h-full flex-col rounded-2xl border border-[#4488FF]/25 bg-[#4488FF]/10 p-5 md:order-2 md:items-end md:text-right">
                <p class="text-xs font-medium uppercase tracking-[0.18em] text-[#4488FF]" style="font-family:'DM Sans',system-ui,sans-serif;">
                  Осень · Юго-Запад · 1
                </p>
                <h3 class="mt-4 text-3xl font-normal tracking-tight" style="font-family:'Cormorant Garamond',Georgia,serif;">
                  Закон и отсечение
                </h3>
                <p class="mt-3 text-sm leading-6 text-[#F4F0E6]/68 md:max-w-[68%]">
                  Критерии, меры, границы ответственности и проверка результата.
                </p>
              </article>
              <!-- Нижний левый: текст и заголовок, затем label — всё прижато к нижнему краю -->
              <article class="order-2 flex h-full flex-col rounded-2xl border border-[#E07020]/25 bg-[#E07020]/10 p-5 md:order-3">
                <div class="mt-auto w-full pt-10">
                  <p class="text-sm leading-6 text-[#F4F0E6]/68 md:max-w-[68%]">
                    Администрирование, распределение усилий, вывод замысла в
                    исполнение.
                  </p>
                  <h3 class="mt-3 text-3xl font-normal tracking-tight" style="font-family:'Cormorant Garamond',Georgia,serif;">
                    Действие и управление
                  </h3>
                  <p class="mt-3 text-xs font-medium uppercase tracking-[0.18em] text-[#E07020]" style="font-family:'DM Sans',system-ui,sans-serif;">
                    Лето · Северо-Восток · 2
                  </p>
                </div>
              </article>
              <!-- Нижний правый: та же логика, прижато к правому краю, цвет — зелёный -->
              <article class="order-5 flex h-full flex-col rounded-2xl border border-[#2D8B5E]/25 bg-[#2D8B5E]/10 p-5 md:order-4 md:items-end md:text-right">
                <div class="mt-auto w-full pt-10">
                  <p class="text-sm leading-6 text-[#F4F0E6]/68 md:ml-auto md:max-w-[68%]">
                    Инфраструктура, хранение, торговый обмен, сохранение опыта.
                  </p>
                  <h3 class="mt-3 text-3xl font-normal tracking-tight" style="font-family:'Cormorant Garamond',Georgia,serif;">
                    Запас и передача
                  </h3>
                  <p class="mt-3 text-xs font-medium uppercase tracking-[0.18em] text-[#2D8B5E]" style="font-family:'DM Sans',system-ui,sans-serif;">
                    Зима · Северо-Запад · 5
                  </p>
                </div>
              </article>

              <!-- Центр: настоящий квадрат (aspect-square), по центру стыка всех четырёх ячеек -->
              <article class="order-3 relative mt-4 flex w-full flex-col items-center justify-center rounded-2xl border border-[#E03030]/30 bg-[#0A1F15] p-4 text-center shadow-[0_20px_60px_rgba(0,0,0,0.45)] md:absolute md:left-1/2 md:top-1/2 md:mt-0 md:aspect-square md:w-[30%] md:-translate-x-1/2 md:-translate-y-1/2 lg:w-[27%] z-10">
                <p class="text-[11px] font-medium uppercase tracking-[0.14em] text-[#E03030]" style="font-family:'DM Sans',system-ui,sans-serif;">
                  Центр · 3 · 金
                </p>
                <h3 class="mt-3 text-2xl font-normal tracking-tight lg:text-3xl" style="font-family:'Cormorant Garamond',Georgia,serif;">
                  Сборка целого
                </h3>
                <p class="mx-auto mt-2 max-w-[18rem] text-xs leading-5 text-[#F4F0E6]/68">
                  Центр фиксирует связь частей, удерживает учёт и переводит
                  отдельные функции в одну систему.
                </p>
              </article>
            </div>
          </div>
        </div>
      </section>

      <!-- FORMULA SECTION -->
      <section id="formula" class="relative bg-[#F4F0E6] px-5 py-20 sm:px-8 lg:px-10">
        <div class="mx-auto max-w-[88rem] rounded-[2rem] border border-[#C49538]/30 bg-white/60 p-8 shadow-[0_32px_100px_rgba(10,31,21,0.08)] backdrop-blur-xl sm:p-10 lg:p-12">
          <div class="grid grid-cols-1 gap-8 lg:grid-cols-[0.8fr_1.2fr] lg:items-center">
            <div>
              <p class="text-xs font-medium uppercase tracking-[0.26em] text-[#2D8B5E]" style="font-family:'DM Sans',system-ui,sans-serif;">
