        { id: 10, cat: 'changes', title: 'Чжоу И / Книга Перемен', han: '周易', epoch: 'Ранняя Чжоу', quote: '«Благородный человек до конца дня непрерывно созидает. Вечером он бдителен»', desc: 'Система учёта состояний: 64 гексаграммы, 32 пары, годовой цикл действий.', detail: 'Чжоу И связывает состояния системы с решением о действии. Формула 360 дней × 32 пары гексаграмм = 11 520 дел показывает строгую рамку распределения ситуаций.' },
        { id: 11, cat: 'changes', title: '10 крыльев', han: '十翼', epoch: 'Чжоу', quote: 'Слой толкования, без которого гексаграмма остаётся немым знаком', desc: 'Пояснительный слой, который раскрывает логику перемен как управляемый порядок.', detail: '10 крыльев дают язык чтения Чжоу И: образ, число, решение, последовательность. В корпусе это слой интерпретации, удерживающий связь между знаком и действием.' },

        { id: 13, cat: 'canon', title: 'Книга Песен', han: '詩經', epoch: 'Чжоу', quote: 'Память общества, закреплённая в ритме речи, а не в указе', desc: 'Социальная память, ритм речи и нормы поведения как управляемый культурный слой.', detail: 'Книга Песен фиксирует язык общества, через который передаётся порядок. В зоне Весны она поддерживает рост формы через речь, память и повторяемые образцы.' },
        { id: 14, cat: 'canon', title: 'Книга Преданий', han: '書經', epoch: 'Ранняя Чжоу', quote: 'Архив решений, где пример прошлого становится нормой для настоящего', desc: 'Документы власти, решений и наследования порядка в форме исторического учёта.', detail: 'Книга Преданий важна как архив управленческого действия. В центре она связывает пример, решение и ответственность, превращая память правления в рабочий стандарт.' },

        { id: 15, cat: 'dao', title: 'Пять явлений', han: '五行', epoch: 'Ранняя древность', quote: 'Пять состояний, через которые распределяется любое действие в системе', desc: 'Описание пяти функциональных состояний, через которые система распределяет действия.', detail: 'Пять явлений читаются как язык распределения функций, а не как отвлечённая схема. Они дают корпусу порядок переходов между сезонами и центральной сборкой.' },
        { id: 16, cat: 'dao', title: 'Рождение Дао', han: '道生', epoch: 'Ранняя древность', quote: 'Момент, где ещё безымянное впервые становится порядком', desc: 'Текст о происхождении порядка из различения и последовательности.', detail: 'Рождение Дао фиксирует момент, где неоформленное становится структурой. В корпусе это центральный источник для понимания появления управляемого порядка.' },
        { id: 17, cat: 'dao', title: 'Обозначение Дао', han: '道名', epoch: 'Ранняя древность', quote: 'Без точного имени функция не может быть ни закреплена, ни передана', desc: 'Язык именования, без которого система не может быть передана и воспроизведена.', detail: 'Обозначение Дао показывает, что управление требует точных имён. Название фиксирует функцию, функция задаёт место, место делает систему воспроизводимой.' },
        { id: 18, cat: 'dao', title: '9 Императоров', han: '九皇', epoch: 'Ранняя древность', quote: 'Девять позиций квадрата — рабочая схема власти, а не украшение', desc: 'Матрица девяти позиций как форма первичного политического и хозяйственного порядка.', detail: '9 Императоров важны для чтения квадрата 3×3. Девять позиций дают не украшение, а рабочую схему распределения власти, места и обязанностей.' },
        { id: 19, cat: 'dao', title: 'Нэй-цзин', han: '內經', epoch: 'До Чжоу', quote: '«Совершенномудрый лечит болезнь, когда она ещё не появилась»', desc: 'Текст о теле как системе циклов, регуляции и распределения функций.', detail: 'Нэй-цзин показывает, что один и тот же код применяется к телу, государству и хозяйству: цикл, центр, функция, мера, своевременность.' },

        { id: 20, cat: 'symbols', title: 'Знак Инь Ян', han: '太極', epoch: 'Ранняя древность', quote: 'Один знак удерживает всю смену режимов: раскрытие и сворачивание', desc: 'Символ смены режимов: действие и удержание, раскрытие и сворачивание.', detail: 'Знак Инь Ян фиксирует режимность системы. Он не заменяет решётку 井, а показывает смену рабочих состояний внутри единого порядка.' },
        { id: 21, cat: 'symbols', title: 'Компас Ло Пань', han: '羅盤', epoch: 'Чжоу', quote: 'Прибор, где направление перестаёт быть догадкой и становится расчётом', desc: 'Инструмент ориентации, где направление становится частью управленческого чтения среды.', detail: 'Ло Пань важен как прибор фиксации направления и положения. В корпусе он поддерживает строгую ориентацию диаграмм: юг расположен вверху.' },
        { id: 22, cat: 'symbols', title: 'Форма Основа', han: '基本形', epoch: 'Ранняя древность', quote: 'Минимальная геометрия, к которой сводится любая частная модель корпуса', desc: 'Базовая форма, через которую частные модели возвращаются к общей структуре.', detail: 'Форма Основа удерживает минимальную геометрию системы. Через неё разные источники читаются не отдельно, а как фрагменты одного устройства.' },
        { id: 23, cat: 'symbols', title: 'Игра Го', han: '圍棋', epoch: 'Ранняя Чжоу', quote: 'Территория, окружение и темп — тот же управленческий код, что и в делах государства', desc: 'Практика территории, окружения, темпа и распределения влияния на поле.', detail: 'Игра Го является практикой чтения поля. Она показывает управленческий код через территорию, окружение, баланс времени и цену каждого хода.' },
        { id: 24, cat: 'symbols', title: 'Игра И', han: '弈', epoch: 'Ранняя Чжоу', quote: 'То же поле, но взгляд смещён на расчёт хода и цену решения', desc: 'Классическое название той же настольной традиции, акцент на расчёте хода и цене решения.', detail: 'Игра И — более раннее, литературное обозначение настольной практики. Внимание смещено с территории на сам расчёт: последовательность ходов, момент решения и его цену.' }
      ];

      // Keep on-page source counts in sync with `sources` so they never go stale
      function pluralizeSources(n) {
        const mod10 = n % 10;
        const mod100 = n % 100;
        if (mod100 >= 11 && mod100 <= 14) return 'источников';
        if (mod10 === 1) return 'источник';
        if (mod10 >= 2 && mod10 <= 4) return 'источника';
        return 'источников';
      }
      (function syncSourceCounts() {
        const count = sources.length;
        const word = pluralizeSources(count);
        const setText = (id, text) => {
          const el = document.getElementById(id);
          if (el) el.textContent = text;
        };
        setText('metaSourceCount', `${count} ${word}`);
        setText('librarySourceCount', `${count} ${word}`);
        setText('ctaSourceCount', `${count} ${word}`);
      })();

      // Maps from Source ID to Starlight Document URIs
      const docUrls = {
        1: '/texts/sunzi/',
        2: '/texts/wei-liao-zi/',
        3: '/texts/tri-strategii/',
        4: '/texts/36-stratagem/',
        5: '/texts/liu-tao/',
        6: '/texts/guy-guy-tszy/',
        7: '/texts/sem-iskusstv/',
        8: '/texts/kniga-osnov/',
        9: '/texts/infu-czin/',
        10: '/texts/chzhou-i/',
        11: '/texts/10-krylev/',
        12: '/texts/chzhou-li/',
        13: '/texts/kniga-pesen/',
        14: '/texts/kniga-predaniy/',
        15: '/texts/pyat-yavleniy/',
        16: '/texts/rozhdenie-dao/',
        17: '/texts/oboznachenie-dao/',
        18: '/texts/9-imperatorov/',
        19: '/texts/su-wen/',
        20: '/texts/znak-in-yan/',
        21: '/texts/kompas-lo-pan/',
        22: '/texts/forma-osnova/',
        23: '/texts/igra-go/',
        24: '/texts/igra-i/'
      };

      let activeCategory = 'all';
      let activeEpoch = 'Все эпохи';
      let searchQuery = '';

      const categoryFilters = document.getElementById('categoryFilters');
      const libraryGrid = document.getElementById('libraryGrid');
      const searchInput = document.getElementById('searchInput');
      const resultsMeta = document.getElementById('resultsMeta');
      const epochButton = document.getElementById('epochButton');
      const epochMenu = document.getElementById('epochMenu');
      const epochLabel = document.getElementById('epochLabel');
      const modal = document.getElementById('sourceModal');
      const modalContent = document.getElementById('modalContent');
      const modalBackdrop = document.getElementById('modalBackdrop');
      const closeModal = document.getElementById('closeModal');

      function categoryById(id) {
        return categories.find(category => category.id === id) || categories[0];
      }

      function renderCategoryFilters() {
        categoryFilters.innerHTML = categories.map(category => {
          const isActive = activeCategory === category.id;
          return `
            <button type="button" data-category="${category.id}" class="category-button inline-flex h-11 shrink-0 items-center justify-center rounded-xl border px-4 text-xs font-medium transition ${isActive ? 'bg-[#0A1F15] text-[#F4F0E6]' : 'bg-white/60 text-[#0A1F15]/70 hover:bg-white'}" style="font-family:'DM Sans',system-ui,sans-serif;border-color:${isActive ? category.color : 'rgba(196,149,56,0.28)'};">
              <span class="mr-2 h-2 w-2 rounded-full" style="background:${category.color};"></span>
              ${category.name}
            </button>
          `;
        }).join('');

        document.querySelectorAll('.category-button').forEach(button => {
          button.addEventListener('click', () => {
            activeCategory = button.dataset.category;
            renderAll();
          });
        });
      }

      function renderEpochMenu() {
        epochMenu.innerHTML = epochs.map(epoch => `
          <button type="button" role="option" aria-selected="${activeEpoch === epoch}" data-epoch="${epoch}" class="epoch-option flex w-full items-center justify-between rounded-xl px-4 py-3 text-left text-sm transition ${activeEpoch === epoch ? 'bg-[#0A1F15] text-[#F4F0E6]' : 'text-[#0A1F15]/72 hover:bg-[#F4F0E6]'}">
            <span>${epoch}</span>
            ${activeEpoch === epoch ? '<iconify-icon icon="solar:check-circle-linear" stroke-width="1.5" class="text-lg text-[#C49538]"></iconify-icon>' : ''}
          </button>
        `).join('');

        document.querySelectorAll('.epoch-option').forEach(button => {
          button.addEventListener('click', () => {
            activeEpoch = button.dataset.epoch;
            epochLabel.textContent = activeEpoch;
            epochMenu.classList.add('hidden');
            epochButton.setAttribute('aria-expanded', 'false');
            renderAll();
          });
        });
      }

      function filteredSources() {
        const query = searchQuery.trim().toLowerCase();
        return sources.filter(source => {
          const matchesCategory = activeCategory === 'all' || source.cat === activeCategory;
          const matchesEpoch = activeEpoch === 'Все эпохи' || source.epoch === activeEpoch;
          const haystack = `${source.title} ${source.han} ${source.desc} ${source.quote} ${categoryById(source.cat).name}`.toLowerCase();
          const matchesQuery = !query || haystack.includes(query);
          return matchesCategory && matchesEpoch && matchesQuery;
        });
      }

      function renderSources() {
        const items = filteredSources();
        resultsMeta.textContent = `Показано источников: ${items.length} из ${sources.length}`;

        const grouped = categories
          .filter(category => category.id !== 'all')
          .map(category => ({
            ...category,
            items: items.filter(source => source.cat === category.id)
          }))
          .filter(group => group.items.length > 0);

        if (!grouped.length) {
          libraryGrid.innerHTML = `
            <div class="rounded-[1.5rem] border border-[#C49538]/30 bg-white/60 p-8 text-center shadow-[0_24px_70px_rgba(10,31,21,0.06)]">
              <p class="text-3xl font-normal tracking-tight text-[#0A1F15]" style="font-family:'Cormorant Garamond',Georgia,serif;">Ничего не найдено</p>
              <p class="mt-3 text-sm text-[#0A1F15]/58" style="font-family:'DM Sans',system-ui,sans-serif;">Измените категорию, эпоху или поисковый запрос.</p>
            </div>
          `;
          return;
        }

        libraryGrid.innerHTML = grouped.map(group => `
          <section aria-label="${group.name}">
            <div class="mb-5 flex items-end justify-between gap-4">
              <div>
                <p class="text-xs font-medium uppercase tracking-[0.2em]" style="font-family:'DM Sans',system-ui,sans-serif;color:${group.color};">${group.items.length} источников</p>
                <h3 class="mt-2 text-4xl font-normal tracking-tight text-[#0A1F15] sm:text-5xl" style="font-family:'Cormorant Garamond',Georgia,serif;">${group.name}</h3>
              </div>
              <div class="hidden h-px flex-1 bg-[#C49538]/20 sm:block"></div>
            </div>
            <div class="grid grid-cols-1 gap-5 md:grid-cols-2 xl:grid-cols-3">
              ${group.items.map(source => sourceCard(source, group)).join('')}
            </div>
          </section>
        `).join('');

        document.querySelectorAll('.source-card').forEach(card => {
          card.addEventListener('click', () => openModal(Number(card.dataset.id)));
          
          // 3D Tilt Card effect
          card.addEventListener('mousemove', event => {
            const rect = card.getBoundingClientRect();
            const x = event.clientX - rect.left;
            const y = event.clientY - rect.top;
            const rotateY = ((x / rect.width) - 0.5) * 7;
            const rotateX = ((0.5 - (y / rect.height)) * 7);
            card.style.transform = `perspective(900px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) translateY(-0.25rem)`;
          });
          card.addEventListener('mouseleave', () => {
            card.style.transform = 'perspective(900px) rotateX(0deg) rotateY(0deg) translateY(0)';
          });
        });
      }

      function sourceCard(source, group) {
        return `
          <button type="button" data-id="${source.id}" class="source-card group flex min-h-80 w-full flex-col rounded-[1.5rem] border bg-white/60 p-6 text-left shadow-[0_24px_70px_rgba(10,31,21,0.07)] backdrop-blur-md transition duration-300 focus:outline-none focus:ring-2 focus:ring-[#2D8B5E] focus:ring-offset-2 focus:ring-offset-[#F4F0E6]" style="border-color:${group.color}55;transform:perspective(900px) rotateX(0deg) rotateY(0deg) translateY(0);">
            <div class="flex items-start justify-between gap-4">
              <div>
                <p class="text-xs font-medium uppercase tracking-[0.16em]" style="font-family:'DM Sans',system-ui,sans-serif;color:${group.color};">${source.epoch}</p>
                <h4 class="mt-4 text-3xl font-normal leading-none tracking-tight text-[#0A1F15]" style="font-family:'Cormorant Garamond',Georgia,serif;">${source.title}</h4>
              </div>
              <span class="text-4xl font-normal leading-none" style="font-family:'Noto Serif SC',serif;color:${group.color};">${source.han}</span>
            </div>
            <p class="mt-6 text-base leading-7 text-[#0A1F15]/66">${source.desc}</p>
            <div class="mt-auto pt-6">
              <div class="flex items-center justify-between gap-4 rounded-xl border border-[#C49538]/20 bg-[#F4F0E6]/65 px-4 py-3">
                <span class="text-xs font-medium text-[#0A1F15]/62" style="font-family:'DM Sans',system-ui,sans-serif;">Перейти к книге</span>
                <iconify-icon icon="solar:arrow-right-linear" stroke-width="1.5" class="text-xl transition group-hover:translate-x-1" style="color:${group.color};"></iconify-icon>
              </div>
            </div>
          </button>
        `;
      }

      function openModal(id) {
        const source = sources.find(item => item.id === id);
        if (!source) return;
        const group = categoryById(source.cat);
        const readLink = docUrls[source.id];

        // Conditional "Read text in library" button if page exists in project
        const readButtonHtml = readLink
          ? `<div class="mt-8 flex justify-start">
               <a href="${readLink}" class="inline-flex h-12 items-center justify-center gap-3 rounded-xl bg-[#0A1F15] px-6 text-sm font-semibold text-[#F4F0E6] hover:bg-[#123625] transition shadow-md">
                 <span>Читать главы в библиотеке</span>
                 <iconify-icon icon="solar:arrow-right-linear" class="text-lg"></iconify-icon>
               </a>
             </div>`
          : '';

        modalContent.innerHTML = `
          <div class="pr-12">
            <p class="text-xs font-medium uppercase tracking-[0.22em]" style="font-family:'DM Sans',system-ui,sans-serif;color:${group.color};">${group.name} · ${source.epoch}</p>
            <div class="mt-4 flex items-start justify-between gap-6">
              <h3 id="modalTitle" class="text-4xl font-normal leading-none tracking-tight text-[#0A1F15] sm:text-5xl lg:text-6xl" style="font-family:'Cormorant Garamond',Georgia,serif;">${source.title}</h3>
              <span class="text-6xl font-normal leading-none sm:text-7xl" style="font-family:'Noto Serif SC',serif;color:${group.color};">${source.han}</span>
            </div>

            <div class="mt-10 space-y-8">
              <div class="rounded-2xl border border-[#C49538]/25 bg-white/60 p-6 shadow-[0_12px_40px_rgba(10,31,21,0.04)]">
                <p class="text-xs font-medium uppercase tracking-[0.18em] text-[#0A1F15]/50" style="font-family:'DM Sans',system-ui,sans-serif;">Цитата</p>
                <div class="mt-3 flex items-start gap-3">
                  <span class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-current/20 bg-current/10 text-xl leading-none" style="color:${group.color}; font-family:'Noto Serif SC',serif;">”</span>
                  <p class="text-lg font-medium italic leading-7 text-[#0A1F15]" style="font-family:'Cormorant Garamond',Georgia,serif;">${source.quote}</p>
                </div>
              </div>

              <div>
                <p class="text-xl font-medium leading-9 text-[#0A1F15]" style="font-family:'Cormorant Garamond',Georgia,serif;">${source.desc}</p>
                <div class="mt-5 h-px w-16 bg-[#C49538]/30"></div>
                <p class="mt-5 text-base leading-8 text-[#0A1F15]/75">${source.detail}</p>
              </div>

              ${readButtonHtml}
            </div>
          </div>
        `;

        modal.classList.remove('hidden');
        modal.classList.add('flex');
        document.body.style.overflow = 'hidden';
      }

      function closeModalHandler() {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        document.body.style.overflow = '';
      }

      function renderAll() {
        renderCategoryFilters();
        renderEpochMenu();
        renderSources();
      }

      searchInput.addEventListener('input', (e) => {
        searchQuery = e.target.value;
        renderAll();
      });

      epochButton.addEventListener('click', () => {
        const isExpanded = epochButton.getAttribute('aria-expanded') === 'true';
        epochButton.setAttribute('aria-expanded', !isExpanded);
        epochMenu.classList.toggle('hidden');
      });

      document.addEventListener('click', (e) => {
        if (!epochButton.contains(e.target) && !epochMenu.contains(e.target)) {
          epochMenu.classList.add('hidden');
          epochButton.setAttribute('aria-expanded', 'false');
        }
      });

      modalBackdrop.addEventListener('click', closeModalHandler);
      closeModal.addEventListener('click', closeModalHandler);
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
          closeModalHandler();
        }
      });

      // Header background opacity change on scroll
      window.addEventListener('scroll', () => {
        const header = document.querySelector('header');
        if (window.scrollY > 50) {
          header.classList.add('shadow-md');
          header.classList.remove('border-b', 'border-[#C49538]/20');
        } else {
          header.classList.remove('shadow-md');
          header.classList.add('border-b', 'border-[#C49538]/20');
        }
      });

      // Mobile header menu (hamburger toggle)
      (function initMobileMenu() {
        const button = document.getElementById('mobileMenuButton');
        const menu = document.getElementById('mobileMenu');
        const backdrop = document.getElementById('mobileMenuBackdrop');
        const iconOpen = document.getElementById('mobileMenuIconOpen');
        const iconClose = document.getElementById('mobileMenuIconClose');
        if (!button || !menu || !backdrop) return;

        const setMenuOpen = (open) => {
          menu.classList.toggle('hidden', !open);
          menu.classList.toggle('flex', open);
          backdrop.classList.toggle('hidden', !open);
          iconOpen.classList.toggle('hidden', open);
          iconClose.classList.toggle('hidden', !open);
          button.setAttribute('aria-expanded', String(open));
          document.body.classList.toggle('overflow-hidden', open);
        };

        button.addEventListener('click', () => {
          setMenuOpen(menu.classList.contains('hidden'));
        });
        backdrop.addEventListener('click', () => setMenuOpen(false));
        menu.querySelectorAll('a').forEach((link) => {
          link.addEventListener('click', () => setMenuOpen(false));
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && !menu.classList.contains('hidden')) {
            setMenuOpen(false);
          }
        });
        window.addEventListener('resize', () => {
          if (window.innerWidth >= 768 && !menu.classList.contains('hidden')) {
            setMenuOpen(false);
          }
        });
      })();

      renderAll();
    </script>
</body>
</html>
