---
// src/pages/index.astro — landing page
---

<!DOCTYPE html>
<html lang="ru" style="scroll-behavior:smooth;">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Путь стратегии · 战略之道 · Колодезная система 井</title>
    
    <!-- External Scripts & Styles -->
    <script src="https://cdn.tailwindcss.com" is:inline></script>
    <script src="https://code.iconify.design/iconify-icon/2.1.0/iconify-icon.min.js" is:inline></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500;1,600;1,700&family=DM+Sans:ital,wght@0,100..900;1,100..900&family=Noto+Serif+SC:wght@200..900&family=Source+Serif+4:ital,opsz,wght@0,8..60;1,8..60&display=swap" />

    <!-- Tailwind Config -->
    <script is:inline>
      tailwind.config = {
        theme: {
          extend: {
            fontFamily: {
              serif: ['"Source Serif 4"', 'Georgia', 'serif'],
              cormorant: ['"Cormorant Garamond"', 'Georgia', 'serif'],
              notoserif: ['"Noto Serif SC"', 'serif'],
              sans: ['"DM Sans"', 'system-ui', 'sans-serif'],
            }
          }
        }
      }
    </script>

    <!-- Custom Animation Styles -->
    <style is:inline>
      @keyframes fadeUp { 
        0% { opacity: 0; transform: translateY(24px); }
        100% { opacity: 1; transform: translateY(0px); }
      }
      .animate-fade-up {
        animation: 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0s 1 normal forwards running fadeUp;
        opacity: 0;
      }
      .delay-150 { animation-delay: 150ms; }
      .delay-300 { animation-delay: 300ms; }
      .delay-450 { animation-delay: 450ms; }
      
      /* Smooth transition for category filtering scrollbar */
      .no-scrollbar::-webkit-scrollbar {
        display: none;
      }
      .no-scrollbar {
        -ms-overflow-style: none;
        scrollbar-width: none;
      }
    </style>
</head>

<body class="min-h-screen overflow-x-hidden bg-[#F4F0E6] text-[#0A1F15] antialiased" style="font-family:'Source Serif 4', Georgia, serif;">
    <main class="relative overflow-hidden">
      
      <!-- HEADER -->
      <header class="fixed left-0 right-0 top-0 z-50 border-b border-[#C49538]/20 bg-[#F4F0E6]/85 backdrop-blur-xl transition duration-300">
        <div class="mx-auto flex max-w-[88rem] h-20 items-center justify-between px-5 sm:px-8 lg:px-14 xl:px-20">
          <a href="#hero" class="flex items-center gap-3 group">
            <iconify-icon icon="mdi:yin-yang" class="text-3xl text-[#0A1F15] transition-transform duration-700 group-hover:rotate-180"></iconify-icon>
            <span class="text-xl font-normal tracking-tight text-[#0A1F15] leading-none" style="font-family:'Cormorant Garamond',Georgia,serif;">
              Путь стратегии
            </span>
          </a>
          <nav class="flex items-center gap-6 sm:gap-8 text-sm font-medium text-[#0A1F15]/75" style="font-family:'DM Sans',system-ui,sans-serif;">
            <a href="/introduction/" class="hover:text-[#2D8B5E] transition">Введение</a>
            <a href="/about/" class="hover:text-[#2D8B5E] transition">О проекте</a>
            <a href="#library" class="hover:text-[#2D8B5E] transition">Библиотека</a>
            <a href="/texts/sunzi/" class="hidden sm:inline-block hover:text-[#2D8B5E] transition">Сунь-Цзы</a>
            <a href="/introduction/" class="flex h-10 items-center justify-center rounded-lg bg-[#0A1F15] px-4 text-xs font-semibold text-[#F4F0E6] hover:bg-[#123625] transition shadow-md">
              Читать главы
            </a>
          </nav>
        </div>
      </header>

      <!-- HERO SECTION -->
      <section class="relative min-h-screen flex flex-col items-center justify-start overflow-hidden px-5 pb-20 pt-36 sm:pt-40 lg:px-10" id="hero">
        <div class="absolute inset-0 z-0">
          <img src="https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/assets/assets/1f4be9bd-8df5-44a8-9862-204eeff5e0b9_1600w.png" alt="Древний город Чжоу и библиотека" class="h-full w-full object-cover object-center">
        </div>

        <!-- Scrim layers: Dense for mobile, gradient for desktop + radial lighting behind text -->
        <div class="absolute inset-0 z-[1] bg-[#F4F0E6]/92 sm:hidden"></div>
        <div class="absolute inset-0 z-[1] hidden sm:block" style="background: linear-gradient(to bottom, rgba(244, 240, 230, 0.78) 0%, rgba(244, 240, 230, 0.55) 45%, rgba(244, 240, 230, 0.2) 75%, transparent 100%);"></div>
        <div class="absolute inset-0 z-[2] pointer-events-none" style="background: radial-gradient(ellipse 65% 50% at 50% 35%, rgba(255, 255, 255, 0.85) 0%, rgba(244, 240, 230, 0.4) 60%, transparent 100%);"></div>

        <div class="relative z-10 flex w-full max-w-4xl flex-col items-center text-center animate-fade-up">
          <!-- 1. Badge (Бейдж) -->
          <div class="inline-flex items-center gap-2.5 rounded-full border border-[#2D8B5E]/30 bg-[#F4F0E6]/85 px-4 py-1.5 shadow-sm backdrop-blur-md font-sans">
            <span class="h-[6px] w-[6px] rounded-full bg-[#E03030]"></span>
            <span class="text-[10px] font-semibold uppercase tracking-[0.2em] text-[#2D8B5E] sm:text-[11px]">
              ДОКУМЕНТАЦИОННЫЙ ПОРТАЛ · 23 ИСТОЧНИКА
            </span>
          </div>

          <!-- 2. Brand signature (Брендовая подпись) -->
          <div class="mt-8 flex items-baseline justify-center gap-2 sm:gap-3 animate-fade-up delay-150">
            <span class="text-3xl font-medium tracking-wider text-[#C49538] font-notoserif sm:text-4xl">
              战略之道
            </span>
          </div>

          <!-- 3. H1 Dominant -->
          <h1 class="mt-4 text-5xl font-normal leading-[1.02] tracking-tight text-[#050C08] sm:text-7xl lg:text-[5.5rem] font-cormorant animate-fade-up delay-300">
            Библиотека свитков
          </h1>

          <!-- 4. Marker string (Маркер-строка) -->
          <p class="mt-2 text-sm font-medium italic tracking-wide text-[#C49538] font-sans sm:text-base animate-fade-up delay-300">
            Не аналогия — исток.
          </p>

          <!-- 5. Subtitle (Тезис) -->
          <p class="mt-6 max-w-[46rem] text-base leading-relaxed text-[#2A2A22]/90 sm:text-lg sm:leading-8 font-serif animate-fade-up delay-450">
            Единый код древних текстов — четыре сезона и центр — напрямую лежит
            в основе современных моделей управления, государства и бизнеса.
            <br class="hidden sm:block">
            Полный свод из 23 источников, от 3000 до н.э. до династии Чжоу,
            собран и описан здесь.
          </p>

          <!-- 6. Meta string (Мета-строка) -->
          <div class="mt-8 flex flex-wrap items-center justify-center gap-x-3 gap-y-2 text-xs text-[#0A1F15]/50 sm:mt-10 sm:text-sm font-sans animate-fade-up delay-450">
            <span>23 источника</span>
            <span class="text-[#0A1F15]/25">·</span>
            <span>6 категорий</span>
            <span class="text-[#0A1F15]/25">·</span>
            <span class="flex items-center gap-1">
              <span class="text-base text-[#C49538] leading-none mb-0.5 font-notoserif">
                井
              </span>
              колодезная система
            </span>
            <span class="text-[#0A1F15]/25">·</span>
            <span>открыты для чтения</span>
          </div>

          <!-- 7. Buttons -->
          <div class="mt-10 flex w-full flex-col items-center justify-center gap-4 sm:w-auto sm:flex-row sm:gap-5 font-sans animate-fade-up delay-450">
            <a href="#library" class="group flex h-14 w-full items-center justify-center gap-3 rounded-xl bg-[#050C08] px-9 text-sm font-medium text-[#F4F0E6] shadow-[0_20px_50px_rgba(10,31,21,0.22)] transition hover:-translate-y-0.5 hover:bg-[#123625] sm:w-auto">
              Войти в библиотеку  ↓
            </a>
            <a href="#system" class="group flex h-14 w-full items-center justify-center gap-3 rounded-xl border border-[#C49538] bg-[#F4F0E6]/70 backdrop-blur-sm px-9 text-sm font-medium text-[#0A1F15] transition hover:-translate-y-0.5 hover:bg-[#F4F0E6]/90 sm:w-auto">
              Смотреть структуру
              <span class="text-xl leading-none text-[#C49538] font-notoserif">
                井
              </span>
            </a>
          </div>
        </div>
      </section>

      <!-- SYSTEM SECTION -->
      <section id="system" class="relative bg-[#0A1F15] px-5 py-24 text-[#F4F0E6] sm:px-8 lg:px-10">
        <div class="absolute inset-0 pointer-events-none bg-[radial-gradient(circle_at_18%_25%,rgba(196,149,56,0.14),transparent_28rem),radial-gradient(circle_at_84%_72%,rgba(45,139,94,0.22),transparent_30rem)]"></div>
        <div class="relative mx-auto grid max-w-[88rem] grid-cols-1 gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
          <div>
            <p class="text-xs font-medium uppercase tracking-[0.26em] text-[#C49538]" style="font-family:'DM Sans',system-ui,sans-serif;">
              Карта системы
            </p>
            <h2 class="mt-6 text-5xl font-normal leading-[1.02] tracking-tight sm:text-6xl lg:text-7xl" style="font-family:'Cormorant Garamond',Georgia,serif;">
              Четыре сезона + центр как навигационная решётка 井
            </h2>
            <p class="mt-7 max-w-2xl text-lg leading-8 text-[#F4F0E6]/72">
              Корпус организован не по внешним темам, а по месту текста в общей
              структуре: направление, сезон, центр, функция. Это позволяет
              читать источники как единую документацию управленческого кода.
            </p>
            <div class="mt-9 grid grid-cols-1 gap-4 sm:grid-cols-3" style="font-family:'DM Sans',system-ui,sans-serif;">
              <div class="rounded-2xl border border-white/10 bg-white/[0.06] p-5">
                <p class="text-3xl font-medium text-[#C49538]">23</p>
                <p class="mt-2 text-sm leading-6 text-[#F4F0E6]/62">
                  источника корпуса
                </p>
              </div>
              <div class="rounded-2xl border border-white/10 bg-white/[0.06] p-5">
                <p class="text-3xl font-medium text-[#08C8A8]">9</p>
                <p class="mt-2 text-sm leading-6 text-[#F4F0E6]/62">
                  позиций решётки
                </p>
              </div>
              <div class="rounded-2xl border border-white/10 bg-white/[0.06] p-5">
                <p class="text-3xl font-medium text-[#E03030]">1</p>
                <p class="mt-2 text-sm leading-6 text-[#F4F0E6]/62">
                  центр сборки
                </p>
              </div>
            </div>
          </div>

          <div class="rounded-[2rem] border border-white/12 bg-white/[0.06] p-5 shadow-[0_36px_110px_rgba(0,0,0,0.28)] backdrop-blur-xl">
            <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
              <article class="rounded-2xl border border-[#08C8A8]/25 bg-[#08C8A8]/10 p-5">
                <p class="text-xs font-medium uppercase tracking-[0.18em] text-[#08C8A8]" style="font-family:'DM Sans',system-ui,sans-serif;">
                  Весна · Юго-Восток · 4
                </p>
                <h3 class="mt-4 text-3xl font-normal tracking-tight" style="font-family:'Cormorant Garamond',Georgia,serif;">
                  Запуск и рост
                </h3>
                <p class="mt-3 text-sm leading-6 text-[#F4F0E6]/68">
                  Образование формы, прорастание функции, начало управляемого
                  цикла.
                </p>
              </article>
              <article class="rounded-2xl border border-[#4488FF]/25 bg-[#4488FF]/10 p-5">
                <p class="text-xs font-medium uppercase tracking-[0.18em] text-[#4488FF]" style="font-family:'DM Sans',system-ui,sans-serif;">
                  Осень · Юго-Запад · 1
                </p>
                <h3 class="mt-4 text-3xl font-normal tracking-tight" style="font-family:'Cormorant Garamond',Georgia,serif;">
                  Закон и отсечение
                </h3>
                <p class="mt-3 text-sm leading-6 text-[#F4F0E6]/68">
                  Критерии, меры, границы ответственности и проверка результата.
                </p>
              </article>
              <article class="rounded-2xl border border-[#E07020]/25 bg-[#E07020]/10 p-5">
                <p class="text-xs font-medium uppercase tracking-[0.18em] text-[#E07020]" style="font-family:'DM Sans',system-ui,sans-serif;">
                  Лето · Северо-Восток · 2
                </p>
                <h3 class="mt-4 text-3xl font-normal tracking-tight" style="font-family:'Cormorant Garamond',Georgia,serif;">
                  Действие и управление
                </h3>
                <p class="mt-3 text-sm leading-6 text-[#F4F0E6]/68">
                  Администрирование, распределение усилий, вывод замысла в
                  исполнение.
                </p>
              </article>
              <article class="rounded-2xl border border-[#B07838]/25 bg-[#B07838]/10 p-5">
                <p class="text-xs font-medium uppercase tracking-[0.18em] text-[#B07838]" style="font-family:'DM Sans',system-ui,sans-serif;">
                  Зима · Северо-Запад · 5
                </p>
                <h3 class="mt-4 text-3xl font-normal tracking-tight" style="font-family:'Cormorant Garamond',Georgia,serif;">
                  Запас и передача
                </h3>
                <p class="mt-3 text-sm leading-6 text-[#F4F0E6]/68">
                  Инфраструктура, хранение, торговый обмен, сохранение опыта.
                </p>
              </article>
            </div>
            <article class="mt-4 rounded-2xl border border-[#E03030]/25 bg-[#E03030]/10 p-5 text-center">
              <p class="text-xs font-medium uppercase tracking-[0.18em] text-[#E03030]" style="font-family:'DM Sans',system-ui,sans-serif;">
                Центр · 3 · 金
              </p>
              <h3 class="mt-4 text-4xl font-normal tracking-tight" style="font-family:'Cormorant Garamond',Georgia,serif;">
                Сборка целого
              </h3>
              <p class="mx-auto mt-3 max-w-2xl text-sm leading-6 text-[#F4F0E6]/68">
                Центр фиксирует связь частей, удерживает учёт и переводит
                отдельные функции в одну систему.
              </p>
            </article>
          </div>
        </div>
      </section>

      <!-- FORMULA SECTION -->
      <section id="formula" class="relative bg-[#F4F0E6] px-5 py-20 sm:px-8 lg:px-10">
        <div class="mx-auto max-w-[88rem] rounded-[2rem] border border-[#C49538]/30 bg-white/60 p-8 shadow-[0_32px_100px_rgba(10,31,21,0.08)] backdrop-blur-xl sm:p-10 lg:p-12">
          <div class="grid grid-cols-1 gap-8 lg:grid-cols-[0.8fr_1.2fr] lg:items-center">
            <div>
              <p class="text-xs font-medium uppercase tracking-[0.26em] text-[#2D8B5E]" style="font-family:'DM Sans',system-ui,sans-serif;">
                Математическая и космологическая опора
              </p>
              <h2 class="mt-5 text-5xl font-normal leading-[1.04] tracking-tight text-[#0A1F15] sm:text-6xl" style="font-family:'Cormorant Garamond',Georgia,serif;">
                Строгость структуры
              </h2>
            </div>
            <div class="grid grid-cols-1 gap-4 md:grid-cols-2" style="font-family:'DM Sans',system-ui,sans-serif;">
              <div class="rounded-2xl border border-[#C49538]/30 bg-[#F4F0E6]/70 p-6">
                <p class="text-4xl font-medium tracking-tight text-[#C49538]">
                  360 × 32 = 11 520
                </p>
                <p class="mt-3 text-sm leading-6 text-[#0A1F15]/65">
                  360 дней × 32 пары гексаграмм = 11 520 дел. Формула задаёт
                  строгую рамку учёта действий.
                </p>
              </div>
              <div class="rounded-2xl border border-[#2D8B5E]/30 bg-[#F4F0E6]/70 p-6">
                <p class="text-4xl font-medium tracking-tight text-[#2D8B5E]">
                  Спираль
                </p>
                <p class="mt-3 text-sm leading-6 text-[#0A1F15]/65">
                  Земля движется вокруг Солнца, Солнце — вокруг центра
                  галактики. Спиральная структура задаёт наблюдаемую рамку
                  циклов.
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- LIBRARY SECTION -->
      <section id="library" class="relative bg-[#F4F0E6] px-5 py-24 sm:px-8 lg:px-10">
        <div class="relative mx-auto max-w-[88rem]">
          <div class="max-w-4xl">
            <p class="text-xs font-medium uppercase tracking-[0.26em] text-[#2D8B5E]" style="font-family:'DM Sans',system-ui,sans-serif;">
              Библиотека корпуса
            </p>
            <h2 id="sources" class="mt-6 text-5xl font-normal leading-[1.02] tracking-tight text-[#0A1F15] sm:text-6xl lg:text-7xl" style="font-family:'Cormorant Garamond',Georgia,serif;">
              23 источника в шести категориях
            </h2>
            <p class="mt-7 max-w-3xl text-lg leading-8 text-[#0A1F15]/66">
              Найдите текст по категории, эпохе, русскому названию или
              иероглифам. Каждая карточка раскрывает место источника в структуре
              сезонов и центра.
            </p>
          </div>

          <!-- FILTERS HEADER (STICKY) -->
          <div class="sticky top-24 z-40 mt-10 rounded-[1.5rem] border border-[#C49538]/30 bg-[#F4F0E6]/90 p-4 shadow-[0_20px_70px_rgba(10,31,21,0.10)] backdrop-blur-xl">
            <div class="grid grid-cols-1 gap-4 lg:grid-cols-[1fr_auto] lg:items-center">
              <div class="flex flex-col gap-3">
                <div class="relative">
                  <iconify-icon icon="solar:magnifer-linear" stroke-width="1.5" class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-xl text-[#0A1F15]/45"></iconify-icon>
                  <input id="searchInput" type="search" aria-label="Поиск по названию и иероглифу" placeholder="Поиск по названию, иероглифу или функции" class="h-12 w-full rounded-xl border border-[#C49538]/25 bg-white/70 pl-12 pr-4 text-sm text-[#0A1F15] outline-none ring-0 transition placeholder:text-[#0A1F15]/38 focus:border-[#2D8B5E]" style="font-family:'DM Sans',system-ui,sans-serif;">
                </div>
                <!-- Categories buttons list -->
                <div id="categoryFilters" class="flex gap-2 overflow-x-auto pb-1 no-scrollbar">
                  <!-- Rendered dynamically -->
                </div>
              </div>

              <!-- Epoch Selector -->
              <div class="relative">
                <button id="epochButton" type="button" aria-haspopup="listbox" aria-expanded="false" class="flex h-12 min-w-56 w-full lg:w-auto items-center justify-between gap-4 rounded-xl border border-[#C49538]/25 bg-white/70 px-4 text-sm font-medium text-[#0A1F15] outline-none transition hover:bg-white" style="font-family:'DM Sans',system-ui,sans-serif;">
                  <span id="epochLabel">Все эпохи</span>
                  <iconify-icon icon="solar:alt-arrow-down-linear" stroke-width="1.5" class="text-lg text-[#C49538]"></iconify-icon>
                </button>
                <div id="epochMenu" role="listbox" class="absolute right-0 top-14 hidden w-72 rounded-2xl border border-[#C49538]/25 bg-white p-2 shadow-[0_24px_70px_rgba(10,31,21,0.14)] z-50" style="font-family:'DM Sans',system-ui,sans-serif;">
                  <!-- Rendered dynamically -->
                </div>
              </div>
            </div>
          </div>

          <!-- Dynamic Library Grid -->
          <div id="resultsMeta" class="mt-8 text-sm text-[#0A1F15]/58" style="font-family:'DM Sans',system-ui,sans-serif;">Показано источников: 23 из 23</div>
          <div id="libraryGrid" class="mt-8 space-y-12">
            <!-- Groups and Cards Rendered dynamically -->
          </div>
        </div>
      </section>

      <!-- RECOGNITION / CTA SECTION -->
      <section id="recognition" class="relative min-h-[680px] overflow-hidden px-5 py-28 sm:px-8 sm:py-36 lg:px-10">
        <div class="absolute inset-0 z-0">
          <img src="https://hoirqrkdgbmvpwutwuwj.supabase.co/storage/v1/object/public/assets/assets/b394239e-2bfd-443e-a0cc-ec22352f4c24_1600w.png" alt="Совет основателей династии Чжоу" class="h-full w-full object-cover object-center">
        </div>

        <div class="absolute inset-0 z-[1]" style="background: linear-gradient(to bottom, rgba(5,18,10,0.38) 0%, rgba(5,18,10,0.55) 30%, rgba(5,18,10,0.62) 55%, rgba(5,18,10,0.72) 100%)"></div>
        <div class="absolute inset-0 z-[2] pointer-events-none" style="background: radial-gradient(ellipse 70% 60% at 50% 42%, rgba(5,18,10,0.52) 0%, transparent 100%);"></div>

        <div class="relative z-10 mx-auto flex max-w-3xl flex-col items-center text-center">
          <p class="text-[10px] font-semibold uppercase tracking-[0.28em] text-[#C49538] sm:text-[11px]" style="font-family:'DM Sans',system-ui,sans-serif;">
            Вступление в союз исследователей
          </p>

          <h2 class="mt-6 text-5xl font-normal leading-[1.03] tracking-tight text-[#F4F0E6] sm:text-6xl lg:text-7xl" style="font-family:'Cormorant Garamond',Georgia,serif;">
            Войти в Ворота Знания
          </h2>

          <div class="relative mt-10 flex items-start gap-4 text-left sm:mt-12">
            <div class="mt-1 w-[3px] shrink-0 self-stretch rounded-full bg-[#C49538]/70"></div>
            <div>
              <p class="leading-8 sm:leading-9 sm:text-2xl text-lg italic text-slate-200/95" style="font-family: 'Source Serif 4', Georgia, serif">
