---
// src/pages/index.astro — landing page
import { getCollection } from 'astro:content';

const docs = await getCollection('docs');
const groups = [...new Set(docs.filter(d => d.data.group).map(d => d.data.group))];
const wuxing = ['木', '火', '土', '金', '水'];
---

<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Путь Стратегии</title>
  <style is:global>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Noto Serif', 'Georgia', serif;
      background: #0f0a05;
      color: #e8dcc4;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 0 1rem;
    }

    .hero {
      text-align: center;
      padding: 5rem 0 3rem;
      max-width: 720px;
    }

    .hero h1 {
      font-size: 3rem;
      font-weight: 400;
      letter-spacing: 0.05em;
      color: #d4af37;
      margin-bottom: 0.5rem;
    }

    .hero .chinese {
      font-size: 5rem;
      color: rgba(212, 175, 55, 0.12);
      line-height: 1;
      margin-bottom: 1.5rem;
      user-select: none;
    }

    .hero .subtitle {
      font-size: 1.15rem;
      color: #a09070;
      line-height: 1.6;
      max-width: 560px;
      margin: 0 auto;
    }

    .groups {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
      max-width: 800px;
      width: 100%;
      margin-bottom: 3rem;
    }

    .group-card {
      background: rgba(212, 175, 55, 0.05);
      border: 1px solid rgba(212, 175, 55, 0.12);
      border-radius: 6px;
      padding: 1.25rem 1rem;
      text-align: center;
      transition: border-color 0.2s, background 0.2s;
      text-decoration: none;
      color: inherit;
    }

    .group-card:hover {
      border-color: rgba(212, 175, 55, 0.35);
      background: rgba(212, 175, 55, 0.08);
    }

    .group-card h3 {
      font-size: 1.05rem;
      font-weight: 400;
      color: #d4af37;
      margin-bottom: 0.35rem;
    }

    .group-card .count {
      font-size: 0.85rem;
      color: #6b5e4a;
    }

    .wuxing-bar {
      display: flex;
      gap: 0.5rem;
      max-width: 360px;
      width: 100%;
      margin-bottom: 3rem;
    }

    .wuxing-bar span {
      flex: 1;
      text-align: center;
      font-size: 1.6rem;
      opacity: 0.5;
      transition: opacity 0.2s;
    }

    .wuxing-bar span:hover { opacity: 1; }

    .nav-links {
      display: flex;
      gap: 2rem;
      margin-bottom: 4rem;
    }

    .nav-links a {
      color: #a09070;
      text-decoration: none;
      font-size: 0.95rem;
      border-bottom: 1px solid transparent;
      transition: color 0.2s, border-color 0.2s;
    }

    .nav-links a:hover {
      color: #d4af37;
      border-color: #d4af37;
    }

    footer {
      color: #4a3d2e;
      font-size: 0.8rem;
      margin-bottom: 2rem;
    }

    @media (max-width: 600px) {
      .groups { grid-template-columns: repeat(2, 1fr); }
      .hero h1 { font-size: 2.2rem; }
      .hero .chinese { font-size: 3.5rem; }
    }
  </style>
</head>
<body>
  <div class="hero">
    <div class="chinese">道</div>
    <h1>Путь Стратегии</h1>
    <p class="subtitle">
      Исследование ~30 древнекитайских классических текстов как единой системы,
      основанной на космологии У-Син (五行)
    </p>
  </div>

  <div class="groups">
    <a href="/introduction/" class="group-card">
      <h3>兵略</h3>
      <div class="count">Стратегия</div>
    </a>
    <a href="/introduction/" class="group-card">
      <h3>治術</h3>
      <div class="count">Управление</div>
    </a>
    <a href="/introduction/" class="group-card">
      <h3>宇宙秩序</h3>
      <div class="count">Космос</div>
    </a>
    <a href="/introduction/" class="group-card">
      <h3>五失典籍</h3>
      <div class="count">Утраченные</div>
    </a>
    <a href="/introduction/" class="group-card">
      <h3>身·文</h3>
      <div class="count">Тело / Культура</div>
    </a>
    <a href="/introduction/" class="group-card">
      <h3>器·符</h3>
      <div class="count">Инструменты / Символы</div>
    </a>
  </div>

  <div class="wuxing-bar">
    <span style="color: #4caf50">木</span>
    <span style="color: #f44336">火</span>
    <span style="color: #ff9800">土</span>
    <span style="color: #d4af37">金</span>
    <span style="color: #2196f3">水</span>
  </div>

  <nav class="nav-links">
    <a href="/introduction/">Введение</a>
    <a href="/about/">О проекте</a>
    <a href="/texts/sunzi/">Сунь-Цзы</a>
    <a href="/texts/liu-tao/">Лю Тао</a>
  </nav>

  <footer>
    Путь Стратегии · Path of Strategy
  </footer>
</body>
</html>
