---
// src/pages/privacy/index.astro — Политика конфиденциальности
import '../../styles/global.css';
---

<!DOCTYPE html>
<html lang="ru" style="scroll-behavior:smooth;">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Политика конфиденциальности · Путь стратегии</title>
    <meta name="description" content="Политика конфиденциальности документационного портала «Путь стратегии»." />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icon-192.png" />

    <!-- External Scripts & Styles -->
    <script src="/scripts/iconify-icon.min.js" is:inline></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500;1,600;1,700&family=DM+Sans:ital,wght@0,100..900;1,100..900&family=Noto+Serif+SC:wght@200..900&family=Source+Serif+4:ital,opsz,wght@0,8..60;1,8..60&display=swap" />
</head>

<body class="min-h-screen flex flex-col bg-[#F4F0E6] text-[#0A1F15] antialiased" style="font-family:'Source Serif 4', Georgia, serif;">

    <!-- HEADER -->
    <header class="sticky top-0 z-50 border-b border-[#C49538]/20 bg-[#F4F0E6]/85 backdrop-blur-xl transition duration-300">
      <div class="mx-auto flex max-w-[88rem] h-20 items-center justify-between px-5 sm:px-8 lg:px-14 xl:px-20">
        <a href="/" class="flex items-center gap-3 group">
          <iconify-icon icon="mdi:yin-yang" class="text-3xl text-[#0A1F15] transition-transform duration-700 group-hover:rotate-180"></iconify-icon>
          <span class="text-[2.5rem] font-normal tracking-tight text-[#0A1F15] leading-none" style="font-family:'Kashima','DS China','Cormorant Garamond',Georgia,serif;">
            Путь стратегии
          </span>
        </a>
        <nav class="hidden md:flex items-center gap-6 sm:gap-8 text-sm font-medium text-[#0A1F15]/75" style="font-family:'DM Sans',system-ui,sans-serif;">
          <a href="/about/" class="hover:text-[#2D8B5E] transition">О проекте</a>
          <a href="/introduction/" class="hover:text-[#2D8B5E] transition">Библиотека</a>
          <a href="/blog/" class="hover:text-[#2D8B5E] transition">Заметки</a>
          <a href="https://github.com/great-foundation-pro/doc-pathofstrategy" target="_blank" rel="noopener noreferrer" class="flex items-center gap-1 hover:text-[#2D8B5E] transition" aria-label="GitHub">
            <iconify-icon icon="mdi:github" class="text-lg"></iconify-icon>
            <iconify-icon icon="mdi:open-in-new" class="text-xs"></iconify-icon>
          </a>
          <a href="https://pathofstrategy.com/" target="_blank" rel="noopener noreferrer" class="flex items-center hover:opacity-75 transition" aria-label="Путь стратегии">
            <img src="/images/pathofstrategy-logo.png" alt="Путь стратегии" class="h-5 w-5" />
          </a>
          <a href="https://doc.pathofstrategy.com/blog/rss.xml" class="flex items-center hover:text-[#2D8B5E] transition" aria-label="RSS">
            <iconify-icon icon="mdi:rss" class="text-lg"></iconify-icon>
          </a>
          <a href="https://pathofstrategy.com/community/" target="_blank" rel="noopener noreferrer" class="flex h-10 items-center justify-center rounded-lg bg-[#0A1F15] px-4 text-xs font-semibold text-[#F4F0E6] hover:bg-[#123625] transition shadow-md">
            Войти в ворота
          </a>
        </nav>

        <button id="mobileMenuButton" type="button" class="flex h-10 w-10 items-center justify-center rounded-lg text-[#0A1F15] transition hover:bg-black/5 md:hidden" aria-label="Открыть меню" aria-expanded="false" aria-controls="mobileMenu">
          <iconify-icon id="mobileMenuIconOpen" icon="mdi:menu" class="text-2xl"></iconify-icon>
          <iconify-icon id="mobileMenuIconClose" icon="mdi:close" class="hidden text-2xl"></iconify-icon>
        </button>
      </div>

      <!-- Mobile dropdown menu -->
      <div id="mobileMenu" class="absolute left-0 right-0 top-full z-50 hidden flex-col gap-1 border-t border-[#C49538]/20 bg-[#F4F0E6] px-5 py-5 shadow-[0_24px_60px_rgba(10,31,21,0.14)] md:hidden" style="font-family:'DM Sans',system-ui,sans-serif;">
        <a href="/about/" class="rounded-lg px-3 py-3 text-base font-medium text-[#0A1F15]/80 transition hover:bg-[#2D8B5E]/10 hover:text-[#2D8B5E]">О проекте</a>
        <a href="/introduction/" class="rounded-lg px-3 py-3 text-base font-medium text-[#0A1F15]/80 transition hover:bg-[#2D8B5E]/10 hover:text-[#2D8B5E]">Библиотека</a>
        <a href="/blog/" class="rounded-lg px-3 py-3 text-base font-medium text-[#0A1F15]/80 transition hover:bg-[#2D8B5E]/10 hover:text-[#2D8B5E]">Заметки</a>
        <a href="https://github.com/great-foundation-pro/doc-pathofstrategy" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 rounded-lg px-3 py-3 text-base font-medium text-[#0A1F15]/80 transition hover:bg-[#2D8B5E]/10 hover:text-[#2D8B5E]">
          <iconify-icon icon="mdi:github" class="text-lg"></iconify-icon> GitHub
          <iconify-icon icon="mdi:open-in-new" class="text-xs"></iconify-icon>
        </a>
        <a href="https://pathofstrategy.com/" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 rounded-lg px-3 py-3 text-base font-medium text-[#0A1F15]/80 transition hover:bg-[#2D8B5E]/10 hover:text-[#2D8B5E]">
          <img src="/images/pathofstrategy-logo.png" alt="" class="h-5 w-5" /> Путь стратегии
        </a>
        <a href="https://doc.pathofstrategy.com/blog/rss.xml" class="flex items-center gap-2 rounded-lg px-3 py-3 text-base font-medium text-[#0A1F15]/80 transition hover:bg-[#2D8B5E]/10 hover:text-[#2D8B5E]">
          <iconify-icon icon="mdi:rss" class="text-lg"></iconify-icon> RSS
        </a>
        <a href="https://pathofstrategy.com/community/" target="_blank" rel="noopener noreferrer" class="mt-2 flex h-12 items-center justify-center rounded-lg bg-[#0A1F15] px-4 text-sm font-semibold text-[#F4F0E6] shadow-md transition hover:bg-[#123625]">
          Войти в ворота
        </a>
      </div>
    </header>
    <div id="mobileMenuBackdrop" class="fixed inset-x-0 bottom-0 top-20 z-40 hidden bg-[#0A1F15]/40 md:hidden"></div>

    <!-- PAGE TITLE -->
    <section class="relative overflow-hidden px-5 pt-16 pb-16 sm:px-8 sm:pt-24 sm:pb-20 lg:px-10">
      <div class="absolute inset-0 z-0">
        <img src="/images/hero-bg.webp" alt="Древний город Чжоу и библиотека" class="h-full w-full object-cover object-center">
      </div>
      <div class="absolute inset-0 z-[1] bg-[#F4F0E6]/92 sm:hidden"></div>
      <div class="absolute inset-0 z-[1] hidden sm:block" style="background: linear-gradient(to bottom, rgba(244, 240, 230, 0.85) 0%, rgba(244, 240, 230, 0.7) 50%, rgba(244, 240, 230, 0.55) 100%);"></div>
      <div class="absolute inset-0 z-[2] pointer-events-none" style="background: radial-gradient(ellipse 65% 60% at 35% 35%, rgba(255, 255, 255, 0.75) 0%, rgba(244, 240, 230, 0.3) 60%, transparent 100%);"></div>

      <div class="relative z-10 mx-auto max-w-3xl">
        <div class="inline-flex items-center gap-2.5 rounded-full border border-[#2D8B5E]/30 bg-[#F4F0E6]/85 px-4 py-1.5 shadow-sm backdrop-blur-md font-sans">
          <span class="h-[6px] w-[6px] rounded-full bg-[#C49538]"></span>
          <span class="text-[10px] font-semibold uppercase tracking-[0.2em] text-[#2D8B5E] sm:text-[11px]">
            ПУТЬ СТРАТЕГИИ
          </span>
        </div>
        <h1 class="mt-6 text-5xl font-normal leading-tight tracking-tight text-[#050C08] sm:text-6xl" style="font-family:'Cormorant Garamond',Georgia,serif;">
          Политика конфиденциальности
        </h1>
        <p class="mt-4 text-sm text-[#0A1F15]/50" style="font-family:'DM Sans',system-ui,sans-serif;">
          Документационный портал «Путь стратегии»
        </p>
      </div>
    </section>

    <!-- CONTENT -->
    <main class="flex-grow px-5 pb-24 sm:px-8 lg:px-10">
      <div class="mx-auto max-w-3xl border-t border-[#C49538]/20 pt-12 text-base leading-8 text-[#0A1F15]/85" style="font-family:'Source Serif 4',Georgia,serif;">
        <p class="italic text-[#0A1F15]/40">Текст раздела появится здесь.</p>
      </div>
    </main>

    <!-- FOOTER -->
    <footer class="w-full border-t border-[#C49538]/20 bg-[#050B08] text-[#F4F0E6]/80 py-6">
      <div class="flex flex-col sm:flex-row items-center justify-between text-[13px] px-5 sm:px-8 lg:px-14 xl:px-20 mx-auto max-w-[88rem]" style="font-family:'DM Sans',system-ui,sans-serif;">
        <p>© 2852 — 2025 Путь стратегии. Все права сонастроены.</p>
        <p class="mt-2 sm:mt-0 space-x-1">
          <a href="/" class="underline underline-offset-4 decoration-white/20 hover:decoration-white transition">Главная</a>
          <span>·</span>
          <a href="/privacy/" class="underline underline-offset-4 decoration-white/20 hover:decoration-white transition">Политика конфиденциальности</a>
          <span>·</span>
          <a href="/terms/" class="underline underline-offset-4 decoration-white/20 hover:decoration-white transition">Условия участия</a>
        </p>
      </div>
    </footer>

    <script is:inline>
      (function initMobileMenu() {
        const button = document.getElementById('mobileMenuButton');
        const menu = document.getElementById('mobileMenu');
        const backdrop = document.getElementById('mobileMenuBackdrop');
        const iconOpen = document.getElementById('mobileMenuIconOpen');
        const iconClose = document.getElementById('mobileMenuIconClose');
        if (!button || !menu || !backdrop) return;
        const setMenuOpen = (open) => {
          menu.classList.toggle('hidden', !open);
          menu.classList.toggle('flex', open);
          backdrop.classList.toggle('hidden', !open);
          iconOpen.classList.toggle('hidden', open);
          iconClose.classList.toggle('hidden', !open);
          button.setAttribute('aria-expanded', String(open));
          document.body.classList.toggle('overflow-hidden', open);
        };
        button.addEventListener('click', () => setMenuOpen(menu.classList.contains('hidden')));
        backdrop.addEventListener('click', () => setMenuOpen(false));
        menu.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMenuOpen(false)));
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !menu.classList.contains('hidden')) setMenuOpen(false); });
        window.addEventListener('resize', () => { if (window.innerWidth >= 768 && !menu.classList.contains('hidden')) setMenuOpen(false); });
      })();
    </script>

</body>
</html>
